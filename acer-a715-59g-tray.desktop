[Desktop Entry]
Type=Application
Version=1.0
Name=Acer Aspire A715-59G Tray Indicator
GenericName=Hardware & Power Tray Indicator
Comment=System tray indicator and quick-control menu for Acer Aspire A715-59G
Exec=/usr/bin/python3 /opt/acer-aspire-a715-59g-linux-control/tray.py
Icon=preferences-system
Terminal=false
Categories=System;Utility;
NoDisplay=true
X-GNOME-Autostart-enabled=true
